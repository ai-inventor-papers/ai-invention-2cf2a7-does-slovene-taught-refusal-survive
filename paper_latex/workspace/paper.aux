\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Signal-detection parameters from Experiment\nobreakspace  {}5 on the HARD set (1,093 benign and 349 harmful items; Slovene machine translations vs English back-translations; refusals labelled by a local Qwen3-14B judge, with partial answers coded as non-refusals). Blue bars are English prompts and orange bars are Slovene prompts, for Gemma-3-12B-IT (``Gemma\nobreakspace  {}3'') and GaMS3-12B-Instruct (``GaMS3''). (a)\nobreakspace  {}False-alarm rate $F$, the proportion of benign items refused, with Wilson 95\% confidence intervals. Brackets give the paired Slovene$-$English difference and an exact McNemar test on the same items. Gemma's rate rises from 0.364 to 0.569 ($p<10^{-28}$), while GaMS3 refuses 0.273 of benign items in both languages ($p=1.0$). (b)\nobreakspace  {}SDT criterion $c$ in $z$ units, where more negative means a greater tendency to refuse. Lower brackets show the within-model shift $\Delta c$ (Slovene$-$English, 95\% CI): Gemma moves toward refusing in Slovene ($c=-0.87$ vs $-0.44$; $\Delta c=-0.43$ [$-0.57$, $-0.31$]), while GaMS3 does not ($-0.23$ vs $-0.33$; $\Delta c=+0.09$ [$-0.002$, $0.19$]). The upper bracket gives the difference-in-differences $\mathrm  {DiD}_c=+0.52$ [0.38, 0.68]. The corresponding DiD on sensitivity $d'$ ($-0.003$ [$-0.33$, $0.29$]) is indistinguishable from zero, so the asymmetry lies in the threshold rather than in discrimination. This finding is rated ESTIMATE: coding partial answers as refusals reverses $\mathrm  {DiD}_c$ to $-0.31$ [$-0.62$, $-0.09$].}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:sdt}{{1}{5}{Signal-detection parameters from Experiment~5 on the HARD set (1,093 benign and 349 harmful items; Slovene machine translations vs English back-translations; refusals labelled by a local Qwen3-14B judge, with partial answers coded as non-refusals). Blue bars are English prompts and orange bars are Slovene prompts, for Gemma-3-12B-IT (``Gemma~3'') and GaMS3-12B-Instruct (``GaMS3''). (a)~False-alarm rate $F$, the proportion of benign items refused, with Wilson 95\% confidence intervals. Brackets give the paired Slovene$-$English difference and an exact McNemar test on the same items. Gemma's rate rises from 0.364 to 0.569 ($p<10^{-28}$), while GaMS3 refuses 0.273 of benign items in both languages ($p=1.0$). (b)~SDT criterion $c$ in $z$ units, where more negative means a greater tendency to refuse. Lower brackets show the within-model shift $\Delta c$ (Slovene$-$English, 95\% CI): Gemma moves toward refusing in Slovene ($c=-0.87$ vs $-0.44$; $\Delta c=-0.43$ [$-0.57$, $-0.31$]), while GaMS3 does not ($-0.23$ vs $-0.33$; $\Delta c=+0.09$ [$-0.002$, $0.19$]). The upper bracket gives the difference-in-differences $\mathrm {DiD}_c=+0.52$ [0.38, 0.68]. The corresponding DiD on sensitivity $d'$ ($-0.003$ [$-0.33$, $0.29$]) is indistinguishable from zero, so the asymmetry lies in the threshold rather than in discrimination. This finding is rated ESTIMATE: coding partial answers as refusals reverses $\mathrm {DiD}_c$ to $-0.31$ [$-0.62$, $-0.09$]}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Refusal rates at high edit dose, GaMS3 (harmful items, 200 per cell; cells below 90\% compliance marked $\dag  $).}}{5}{table.3}\protected@file@percent }
\newlabel{tab:gams3_grid}{{3}{5}{Refusal rates at high edit dose, GaMS3 (harmful items, 200 per cell; cells below 90\% compliance marked $\dag $)}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Refusal rates on harmful items at high edit dose in the $3{\times }3$ prompt-language $\times $ requested-reply-language grid (Experiment\nobreakspace  {}14, 200 harmful items per cell, primary-judge raw readout). Rows give the prompt language and columns the requested reply language (EN, SL, HU). Colour encodes the refusal rate on a shared white-to-dark-red scale from 0 to 1. Each cell prints the rate with its Wilson 95\% CI beneath. (a)\nobreakspace  {}Gemma-3-12B-IT: the Slovene-reply column is the most refused (0.560--0.835), the English-reply column the least (0.075--0.185), and the Hungarian-reply column sits in between (0.460--0.550). (b)\nobreakspace  {}GaMS3-12B-Instruct: refusal is uniformly low (0.125--0.280) with no reply-language column pattern. $\dag  $\nobreakspace  {}marks cells whose language compliance, pooled over the three dose levels, is below 90\%. All four are GaMS3 cells off the English-prompt row (SL$\to $EN, SL$\to $HU, HU$\to $EN, HU$\to $SL), so their reply-language labels are unreliable. The Gemma output-language contrast holds on this raw readout, but its PPI-corrected estimate includes zero.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:grid}{{2}{6}{Refusal rates on harmful items at high edit dose in the $3{\times }3$ prompt-language $\times $ requested-reply-language grid (Experiment~14, 200 harmful items per cell, primary-judge raw readout). Rows give the prompt language and columns the requested reply language (EN, SL, HU). Colour encodes the refusal rate on a shared white-to-dark-red scale from 0 to 1. Each cell prints the rate with its Wilson 95\% CI beneath. (a)~Gemma-3-12B-IT: the Slovene-reply column is the most refused (0.560--0.835), the English-reply column the least (0.075--0.185), and the Hungarian-reply column sits in between (0.460--0.550). (b)~GaMS3-12B-Instruct: refusal is uniformly low (0.125--0.280) with no reply-language column pattern. $\dag $~marks cells whose language compliance, pooled over the three dose levels, is below 90\%. All four are GaMS3 cells off the English-prompt row (SL$\to $EN, SL$\to $HU, HU$\to $EN, HU$\to $SL), so their reply-language labels are unreliable. The Gemma output-language contrast holds on this raw readout, but its PPI-corrected estimate includes zero}{figure.2}{}}
